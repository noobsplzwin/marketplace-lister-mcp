{
  "name": "crosslist-mcp",
  "version": "0.1.0",
  "description": "MCP server that posts second-hand listings to online marketplaces from local photo folders. Facebook Marketplace today, built to add more.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "facebook-marketplace",
    "kijiji",
